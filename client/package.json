    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "read-excel-file": "^9.3.10",
    "tesseract.js": "6.0.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@tesseract.js-data/ben": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
